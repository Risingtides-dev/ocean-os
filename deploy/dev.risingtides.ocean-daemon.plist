<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ocean daemon supervisor (OCEAN-253).
       The daemon is the runtime/body: owns the agent loop, tools, sessions,
       permissions, events. It listens on 127.0.0.1:4780. Before this ticket it
       was HAND-LAUNCHED from the repo root (cd <repo> && OCEAN_YOLO=1
       ./target/release/ocean-daemon), so a reboot or crash left it down with no
       version-controlled supervision spec. OCEAN-161 supervised the surface
       PROXY only; this LaunchAgent does the same for the DAEMON itself.

       KeepAlive respawns it whenever it exits so it survives crash/reboot like a
       real service. Install via ops/install-ocean-daemon.sh.

       The launcher execs a PREBUILT release binary — it does NOT recompile on
       respawn. Per the operator's deploy rule the binary must be built from MAIN
       (cargo build -p ocean-daemon --release) before install; to ship new code:
       rebuild from main, then `launchctl kickstart -k`.

       NOTE: paths are absolute and machine-specific to this operator box. -->
  <key>Label</key>
  <string>dev.risingtides.ocean-daemon</string>

  <!-- Exec the supervised launcher, which sets PATH + cwd and exec's the binary.
       (Mirrors the OCEAN-161 proxy plist, which points at its deploy/*.sh.) -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/risingtidesdev/dev/ocean-os/deploy/ocean-daemon.sh</string>
  </array>

  <!-- Neutral cwd ($HOME), NOT the repo. The daemon is workspace-agnostic
       (turns carry their own cwd); its startup guard refuses to boot from
       inside a git repo so unbound fallback turns don't bind to ocean-os
       (see main.rs, OCEAN_ALLOW_REPO_CWD). deploy/ocean-daemon.sh also cd's
       here. BIN is resolved absolutely, so repo-cwd isn't needed. -->
  <key>WorkingDirectory</key>
  <string>/Users/risingtidesdev</string>

  <!-- Respawn on crash/exit. launchd's KeepAlive can't natively curl /health;
       respawn-on-exit is the right primitive — a daemon that exits (crash, OOM,
       panic) comes straight back. ThrottleInterval below bounds a crash loop. -->
  <key>KeepAlive</key>
  <true/>

  <!-- Start as soon as the agent is bootstrapped, and on every login/reboot.
       This is the whole point of the ticket: survive reboot. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Don't hot-loop a hard-failing binary: wait 10s between respawns. A bad
       build (e.g. panics on startup) will still respawn, but at most every 10s
       rather than pinning a core. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Long-running background service; do not let it be aggressively throttled. -->
  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/private/tmp/ocean-daemon.log</string>

  <key>StandardErrorPath</key>
  <string>/private/tmp/ocean-daemon.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Operator default (matches the live hand-launched process): tools run
         without per-call permission prompts. Set OCEAN_YOLO=0 to gate. -->
    <key>OCEAN_YOLO</key>
    <string>1</string>
    <!-- Opt-in local diagnostic: captures complete provider JSON bodies (system
         instruction, trimmed transcript, and tool schemas) under this directory.
         Bodies include private conversation content; the protocol layer writes
         owner-only files and never captures headers or endpoint URLs. Disabled
         unless uncommented for an inspection run. -->
    <!--
    <key>OCEAN_PROMPT_CAPTURE_DIR</key>
    <string>/private/tmp/ocean-prompt-captures</string>
    -->
    <!-- launchd starts with a minimal PATH; give the launcher + daemon a sane
         one (the daemon shells out to git/ripgrep/etc for tool calls). -->
    <key>PATH</key>
    <string>/Users/risingtidesdev/.rustup/toolchains/stable-aarch64-apple-darwin/bin:/Users/risingtidesdev/.cargo/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- OCEAN_BIND is intentionally unset: the binary defaults to
         127.0.0.1:4780, which is exactly what the hand-launched daemon used.
         OCEAN_ASSISTANTS_DIR is likewise unset (defaults to
         ~/.config/ocean-rs/assistants). Add either here only to override. -->
  </dict>
</dict>
</plist>
